{
    "name": "typescript-ai-template",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "setup": "cp .env.example .env || true && npm install && docker compose up -d && npx prisma generate && npx prisma migrate dev --name init --preview-feature || true"
    },
    "dependencies": {
        "@prisma/client": "^5.0.0",
        "awilix": "^8.0.0",
        "express": "^4.18.2",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^4.6.3"
    },
    "devDependencies": {
        "@types/express": "^4.17.17",
        "@types/uuid": "^11.0.0",
        "prisma": "^5.0.0",
        "ts-node": "^10.9.1",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.1.6",
        "typescript-json-schema": "^0.67.1",
        "uuid": "^13.0.0"
    }
}